{
  "info": {
    "name": "Mini Helpdesk System API v1",
    "_postman_id": "a1b2c3d4-helpdesk-collection-v1",
    "description": "Complete Postman collection for the Mini Helpdesk System REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "ticketId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@helpdesk.local\",\n  \"password\": \"SecurePass1\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@helpdesk.local\",\n  \"password\": \"UserPass123!\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Tickets (User)",
      "item": [
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tickets",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot export invoice PDF\",\n  \"description\": \"Clicking download returns a 500 error on billing page.\",\n  \"category\": \"BILLING\",\n  \"priority\": \"HIGH\"\n}"
            }
          }
        },
        {
          "name": "Get My Tickets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/my?page=1&limit=10"
          }
        },
        {
          "name": "Get Ticket By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Update Own Open Ticket",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"URGENT\"\n}"
            }
          }
        },
        {
          "name": "Delete Own Open Ticket",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tickets/{{ticketId}}"
          }
        }
      ]
    },
    {
      "name": "Tickets (Admin)",
      "item": [
        {
          "name": "List All Tickets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/tickets?page=1&limit=10"
          }
        },
        {
          "name": "Update Ticket Status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Update Ticket Priority",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/priority",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"URGENT\"\n}"
            }
          }
        },
        {
          "name": "Assign Ticket",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/admin/tickets/{{ticketId}}/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToId\": null\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Comments & Activity",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"We are investigating this issue.\"\n}"
            }
          }
        },
        {
          "name": "Get Ticket Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/{{ticketId}}/comments?page=1&limit=20"
          }
        },
        {
          "name": "Get Ticket Activity",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/tickets/{{ticketId}}/activity"
          }
        }
      ]
    },
    {
      "name": "Notifications & Dashboard",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications"
          }
        },
        {
          "name": "Mark All Notifications Read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notifications/read-all"
          }
        },
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard/stats"
          }
        }
      ]
    }
  ]
}
